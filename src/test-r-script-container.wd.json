{
  "name": "test-r-script-container",
  "title": "R Script Container Probe",
  "description": "Runs an R script from a GitHub repo + Docker image and reports the R library paths.",
  "triggers": [{ "type": "manual", "name": "manual" }],
  "roles": ["operator"],
  "env": { "GITHUB_TOKEN": "{{GITHUB_TOKEN}}" },
  "steps": [
    {
      "id": "probe",
      "name": "Probe",
      "type": "creation",
      "executor": "script",
      "plugin": "script-container",
      "script": {
        "command": "Rscript /app/scripts/probe.R",
        "dockerfile": "Dockerfile",
        "repo": "https://github.com/vedhav/test-r-workflow",
        "commit": "d2cedf22f1329d1ccfe41ac2516fb5b38b381b54",
        "repoAuth": "GITHUB_TOKEN",
        "timeoutMinutes": 15
      }
    },
    {
      "id": "done",
      "name": "Done",
      "type": "terminal",
      "executor": "human"
    }
  ],
  "transitions": [{ "from": "probe", "to": "done" }]
}
