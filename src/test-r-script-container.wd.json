{
  "name": "test-r-script-container",
  "title": "R Script Container Probe",
  "description": "Builds an image from this repo on the platform and runs scripts/probe.R, reporting the R version and library paths.",
  "triggers": [
    {
      "type": "manual",
      "name": "manual"
    }
  ],
  "roles": ["operator"],
  "env": {
    "GITHUB_TOKEN": "{{GITHUB_TOKEN}}"
  },
  "steps": [
    {
      "id": "probe",
      "name": "Probe",
      "type": "creation",
      "executor": "script",
      "plugin": "script-container",
      "env": {
        "GITHUB_TOKEN": "{{GITHUB_TOKEN}}"
      },
      "script": {
        "command": "Rscript /app/scripts/probe.R",
        "dockerfile": "Dockerfile",
        "repo": "https://github.com/vedhav/test-r-workflow",
        "commit": "b125bc91651670bb4758974f729b28607a46c5e4",
        "repoAuth": "GITHUB_TOKEN",
        "timeoutMinutes": 60
      }
    },
    {
      "id": "done",
      "name": "Done",
      "type": "terminal",
      "executor": "human"
    }
  ],
  "transitions": [
    {
      "from": "probe",
      "to": "done"
    }
  ]
}
